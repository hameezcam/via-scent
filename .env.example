# ==============================================================================
# LOCAL BRAND / DR. SCENT SRI LANKA — ENVIRONMENT CONFIGURATION (PHASE 1 PREVIEW)
# ==============================================================================
# NOTE: This file contains ONLY non-sensitive placeholders.
# Do NOT store real credentials, secrets, or production API keys here.

# Next.js Application Environment
NODE_ENV=development
PORT=3000

# Base Canonical URL
NEXT_PUBLIC_SITE_URL=https://via-scent.vercel.app

# Brand Information Defaults (Overridden in src/config/brand.config.ts)
NEXT_PUBLIC_BRAND_NAME="VIA Scent"
NEXT_PUBLIC_FRANCHISE_STATEMENT="Authorized Franchisee Partner for Dr. Scent"

# ------------------------------------------------------------------------------
# PHASE 2 PREPARATION PLACEHOLDERS (Inactive in Phase 1)
# ------------------------------------------------------------------------------
# PostgreSQL / Prisma Database
# DATABASE_URL="postgresql://user:password@localhost:5432/fragrance_store?schema=public"

# Authentication (NextAuth / Supabase)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret"

# Sri Lanka Digital Payment Gateway (e.g., PayHere / Commercial Bank IPG)
# PAYMENT_GATEWAY_MERCHANT_ID="merchant_id_placeholder"
# PAYMENT_GATEWAY_SECRET="payment_secret_placeholder"

# ------------------------------------------------------------------------------
# FORM EMAIL DELIVERY (Resend) — ACTIVE
# Contact, commercial quote, returns, warranty and newsletter forms email here.
# Without RESEND_API_KEY and FORM_FROM_EMAIL these forms show an error instead
# of silently dropping submissions.
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# FORM_FROM_EMAIL="VIA Scent Website <noreply@vialk.com>"   # domain must be verified in Resend
# FORM_TO_EMAIL="info@vialk.com"                            # optional, this is the default
